<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hospitalária · Monte Sinai Nº 371</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{font-family:'Poppins',sans-serif;background:#f0f4f8;color:#333;min-height:100vh;}

/* HEADER */
header{background:linear-gradient(135deg,#0f2a5a 0%,#1a3a7a 100%);color:white;padding:18px 25px;border-bottom:4px solid #d4af37;box-shadow:0 4px 20px rgba(0,0,0,.25);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;}
.header-left{display:flex;align-items:center;gap:14px;}
.logo-img{width:52px;height:auto;}
.header-title h1{font-size:19px;font-weight:700;line-height:1.2;}
.header-title p{font-size:11px;color:#d4af37;font-weight:600;text-transform:uppercase;letter-spacing:1.2px;}
.header-right{display:flex;align-items:center;gap:10px;}
.user-badge{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:8px;padding:7px 14px;font-size:12px;}
.btn-voltar{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.25);color:white;padding:7px 16px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:.3s;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;gap:6px;}
.btn-voltar:hover{background:rgba(255,255,255,.18);}
.btn-sair{background:transparent;border:2px solid rgba(255,255,255,.35);color:white;padding:7px 16px;border-radius:8px;font-size:12px;font-weight:600;cursor:pointer;transition:.3s;font-family:inherit;}
.btn-sair:hover{background:rgba(255,0,0,.2);border-color:#ff6b6b;}

/* YEAR TABS */
.year-bar{background:white;border-bottom:2px solid #e8e8e8;padding:0 25px;display:flex;align-items:center;gap:0;overflow-x:auto;}
.year-tab{padding:14px 26px;font-size:14px;font-weight:600;color:#888;cursor:pointer;border:none;border-bottom:3px solid transparent;background:none;transition:.25s;font-family:inherit;white-space:nowrap;}
.year-tab:hover{color:#1a3a7a;background:#f8f9ff;}
.year-tab.ativo{color:#1a3a7a;border-bottom-color:#d4af37;background:#f8f9ff;}

/* MAIN */
.container{padding:24px;max-width:1300px;margin:0 auto;}

/* KPI CARDS */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px;margin-bottom:24px;}
.kpi{background:white;border-radius:14px;padding:20px 22px;box-shadow:0 2px 12px rgba(0,0,0,.06);border-left:5px solid #1a3a7a;position:relative;overflow:hidden;transition:.3s;}
.kpi:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.1);}
.kpi.verde{border-left-color:#2e7d32;}
.kpi.vermelho{border-left-color:#c62828;}
.kpi.azul{border-left-color:#1565c0;}
.kpi.ouro{border-left-color:#d4af37;}
.kpi-icon{font-size:28px;margin-bottom:8px;display:block;}
.kpi-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:#888;margin-bottom:6px;}
.kpi-valor{font-size:26px;font-weight:800;color:#1a3a7a;line-height:1;}
.kpi.verde .kpi-valor{color:#2e7d32;}
.kpi.vermelho .kpi-valor{color:#c62828;}
.kpi.azul .kpi-valor{color:#1565c0;}
.kpi.ouro .kpi-valor{color:#b8860b;}
.kpi-sub{font-size:11px;color:#aaa;margin-top:5px;}
.kpi::after{content:'';position:absolute;right:-15px;top:-15px;width:70px;height:70px;border-radius:50%;background:rgba(0,0,0,.03);}

/* GRID LAYOUT */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;}
.grid-3{display:grid;grid-template-columns:2fr 1fr;gap:20px;margin-bottom:20px;}
@media(max-width:900px){.grid-2,.grid-3{grid-template-columns:1fr;}}

/* PANELS */
.panel{background:white;border-radius:14px;box-shadow:0 2px 12px rgba(0,0,0,.06);overflow:hidden;}
.panel-header{padding:18px 22px;border-bottom:1px solid #f0f0f0;display:flex;align-items:center;justify-content:space-between;}
.panel-header h3{font-size:15px;font-weight:700;color:#1a3a7a;}
.panel-header span{font-size:12px;color:#aaa;}
.panel-body{padding:20px 22px;}

/* CHART */
.chart-wrap{position:relative;height:280px;}

/* TABELA LANÇAMENTOS */
.table-wrap{overflow-x:auto;}
table{width:100%;border-collapse:collapse;min-width:500px;}
thead{background:#f8f9fa;}
th{padding:12px 16px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#555;text-align:left;border-bottom:2px solid #eee;}
td{padding:12px 16px;font-size:13px;border-bottom:1px solid #f5f5f5;color:#444;vertical-align:middle;}
tr:hover td{background:#fafbff;}
tr:last-child td{border-bottom:none;}
.badge-tipo{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:20px;font-size:11px;font-weight:700;}
.badge-entrada{background:#e8f5e9;color:#2e7d32;border:1px solid #c8e6c9;}
.badge-saida{background:#ffebee;color:#c62828;border:1px solid #ffcdd2;}
.valor-pos{color:#2e7d32;font-weight:700;}
.valor-neg{color:#c62828;font-weight:700;}

/* TOP SAÍDAS */
.top-item{display:flex;align-items:center;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f5f5f5;}
.top-item:last-child{border-bottom:none;}
.top-rank{width:28px;height:28px;border-radius:50%;background:linear-gradient(135deg,#0f2a5a,#1a3a7a);color:white;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.top-rank.ouro{background:linear-gradient(135deg,#d4af37,#f0d060);}
.top-rank.prata{background:linear-gradient(135deg,#888,#aaa);}
.top-rank.bronze{background:linear-gradient(135deg,#a0522d,#cd853f);}
.top-info{flex:1;margin:0 12px;}
.top-desc{font-size:13px;font-weight:600;color:#333;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:160px;}
.top-data{font-size:11px;color:#aaa;}
.top-valor{font-size:15px;font-weight:800;color:#c62828;white-space:nowrap;}

/* MEDIA CARD */
.media-wrap{display:flex;flex-direction:column;gap:14px;}
.media-item{background:#f8f9ff;border-radius:10px;padding:14px 16px;border-left:4px solid #1a3a7a;}
.media-item.ouro{border-left-color:#d4af37;background:#fffdf0;}
.media-item.verde{border-left-color:#2e7d32;background:#f0faf2;}
.media-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;color:#888;margin-bottom:4px;}
.media-val{font-size:22px;font-weight:800;color:#1a3a7a;}
.media-item.ouro .media-val{color:#b8860b;}
.media-item.verde .media-val{color:#2e7d32;}
.media-sub{font-size:11px;color:#aaa;margin-top:2px;}

/* LOADING / VAZIO */
.loading-state{text-align:center;padding:60px 20px;color:#aaa;}
.loading-state .spinner{width:40px;height:40px;border:3px solid #e0e0e0;border-top-color:#1a3a7a;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 16px;}
@keyframes spin{to{transform:rotate(360deg);}}
.empty-state{text-align:center;padding:40px;color:#bbb;font-size:14px;}

/* FILTRO TIPO */
.filtro-row{display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;}
.filtro-btn{padding:6px 14px;border-radius:20px;border:1px solid #ddd;background:white;font-size:12px;font-weight:600;cursor:pointer;transition:.2s;font-family:inherit;color:#666;}
.filtro-btn.ativo{background:#1a3a7a;color:white;border-color:#1a3a7a;}

/* SALDO BARRA */
.saldo-bar-wrap{margin-top:14px;}
.saldo-bar-label{display:flex;justify-content:space-between;font-size:12px;color:#888;margin-bottom:6px;}
.saldo-bar-track{height:10px;background:#f0f0f0;border-radius:10px;overflow:hidden;}
.saldo-bar-fill{height:100%;border-radius:10px;background:linear-gradient(90deg,#2e7d32,#66bb6a);transition:width 1s ease;}
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="header-left">
    <img src="./logo.png" alt="Logo" class="logo-img">
    <div class="header-title">
      <h1>🏥 Hospitalária</h1>
      <p>Monte Sinai Nº 371 · Controle do Tronco</p>
    </div>
  </div>
  <div class="header-right">
    <span class="user-badge" id="userEmail">—</span>
    <a href="portal.html" class="btn-voltar">← Voltar</a>
    <button class="btn-sair" id="btnSair">Sair</button>
  </div>
</header>

<!-- YEAR TABS -->
<div class="year-bar" id="yearBar"></div>

<!-- MAIN -->
<div class="container">

  <!-- LOADING -->
  <div id="loadingState" class="loading-state">
    <div class="spinner"></div>
    <p>Carregando dados financeiros...</p>
  </div>

  <!-- CONTEÚDO -->
  <div id="conteudo" style="display:none;">

    <!-- KPIs -->
    <div class="kpi-grid">
      <div class="kpi verde">
        <span class="kpi-icon">💰</span>
        <div class="kpi-label">Total Entradas</div>
        <div class="kpi-valor" id="kpiEntradas">R$ 0,00</div>
        <div class="kpi-sub" id="kpiEntradasQtd">0 lançamentos</div>
      </div>
      <div class="kpi vermelho">
        <span class="kpi-icon">📤</span>
        <div class="kpi-label">Total Saídas</div>
        <div class="kpi-valor" id="kpiSaidas">R$ 0,00</div>
        <div class="kpi-sub" id="kpiSaidasQtd">0 lançamentos</div>
      </div>
      <div class="kpi azul">
        <span class="kpi-icon">🏦</span>
        <div class="kpi-label">Saldo do Ano</div>
        <div class="kpi-valor" id="kpiSaldo">R$ 0,00</div>
        <div class="kpi-sub">Entradas − Saídas</div>
      </div>
      <div class="kpi ouro">
        <span class="kpi-icon">📅</span>
        <div class="kpi-label">Média por Reunião</div>
        <div class="kpi-valor" id="kpiMedia">R$ 0,00</div>
        <div class="kpi-sub" id="kpiMediaSub">média das segundas-feiras</div>
      </div>
    </div>

    <!-- GRÁFICO + TOP SAÍDAS -->
    <div class="grid-3">
      <div class="panel">
        <div class="panel-header">
          <h3>📊 Entradas e Saídas por Mês</h3>
          <span id="anoGraficoLabel"></span>
        </div>
        <div class="panel-body">
          <div class="chart-wrap"><canvas id="graficoMensal"></canvas></div>
        </div>
      </div>
      <div class="panel">
        <div class="panel-header">
          <h3>🔺 Maiores Saídas</h3>
          <span>Top 5</span>
        </div>
        <div class="panel-body">
          <div id="topSaidas" class="empty-state">Sem saídas neste ano</div>
        </div>
      </div>
    </div>

    <!-- GRÁFICO EVOLUÇÃO + ESTATÍSTICAS -->
    <div class="grid-2" style="margin-bottom:20px;">
      <div class="panel">
        <div class="panel-header">
          <h3>📈 Evolução do Saldo Acumulado</h3>
        </div>
        <div class="panel-body">
          <div class="chart-wrap"><canvas id="graficoSaldo"></canvas></div>
        </div>
      </div>
      <div class="panel">
        <div class="panel-header">
          <h3>📐 Estatísticas</h3>
        </div>
        <div class="panel-body">
          <div class="media-wrap" id="estatisticas"></div>
        </div>
      </div>
    </div>

    <!-- TABELA LANÇAMENTOS -->
    <div class="panel">
      <div class="panel-header">
        <h3>📋 Lançamentos do Ano</h3>
        <span id="totalLancamentos"></span>
      </div>
      <div class="panel-body" style="padding-bottom:8px;">
        <div class="filtro-row">
          <button class="filtro-btn ativo" onclick="filtrarTabela('todos',this)">Todos</button>
          <button class="filtro-btn" onclick="filtrarTabela('Entrada',this)">💰 Entradas</button>
          <button class="filtro-btn" onclick="filtrarTabela('Saída',this)">📤 Saídas</button>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Data</th>
              <th>Tipo</th>
              <th>Valor</th>
              <th>Descrição</th>
            </tr>
          </thead>
          <tbody id="tabelaBody"></tbody>
        </table>
        <div id="tabelaVazia" class="empty-state" style="display:none;">Nenhum lançamento encontrado.</div>
      </div>
    </div>

  </div><!-- /conteudo -->
</div><!-- /container -->

<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js';
import { getAuth, onAuthStateChanged, signOut } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js';

// ── CONFIG ──────────────────────────────────────────────────
const FIREBASE_CONFIG = {
  apiKey:"AIzaSyAG2f75cmIH7p4tA4AwFoWgQg0DTYRoxW8",
  authDomain:"monte-sinai-recibos.firebaseapp.com",
  projectId:"monte-sinai-recibos",
  storageBucket:"monte-sinai-recibos.firebasestorage.app",
  messagingSenderId:"880791367597",
  appId:"1:880791367597:web:5cbba591d90e41cd56bb24"
};

// URL do Apps Script de leitura da planilha Hospitalaria
// ⚠️ SUBSTITUA pela URL do api_hospitalaria.gs depois de publicar
const API_HOSPITALARIA = 'COLE_AQUI_A_URL_DO_api_hospitalaria.gs';

// Emails autorizados a ver esta página
const EMAILS_AUTORIZADOS = [
  'baronccini89@gmail.com',        // Tesoureiro
  'sergioedsonh@yahoo.com.br',     // Venerável Mestre
  // 'hospitaleiro@email.com',     // Hospitaleiro — adicione quando tiver o email
];

const ANOS_DISPONIVEIS = [2025, 2026, 2027];
const MESES = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];

// ── ESTADO ──────────────────────────────────────────────────
let dadosPorAno = {};
let anoSelecionado = new Date().getFullYear();
let graficoBarra = null;
let graficoLinha = null;
let lancamentosAno = [];

// ── FIREBASE AUTH ────────────────────────────────────────────
const app  = initializeApp(FIREBASE_CONFIG);
const auth = getAuth(app);

onAuthStateChanged(auth, (user) => {
  if (!user) { window.location.replace('index.html'); return; }
  if (!EMAILS_AUTORIZADOS.includes(user.email)) {
    alert('⛔ Acesso restrito. Esta área é exclusiva da Hospitalária.');
    window.location.replace('portal.html');
    return;
  }
  document.getElementById('userEmail').textContent = user.email.split('@')[0];
  document.getElementById('btnSair').onclick = () => signOut(auth).then(() => window.location.replace('index.html'));
  inicializar();
});

// ── INIT ─────────────────────────────────────────────────────
async function inicializar() {
  criarTabs();
  await carregarDados();
}

function criarTabs() {
  const bar = document.getElementById('yearBar');
  ANOS_DISPONIVEIS.forEach(ano => {
    const btn = document.createElement('button');
    btn.className = 'year-tab' + (ano === anoSelecionado ? ' ativo' : '');
    btn.textContent = ano;
    btn.onclick = () => selecionarAno(ano, btn);
    bar.appendChild(btn);
  });
}

function selecionarAno(ano, btn) {
  anoSelecionado = ano;
  document.querySelectorAll('.year-tab').forEach(t => t.classList.remove('ativo'));
  btn.classList.add('ativo');
  renderizarAno();
}

// ── CARREGAR DADOS ───────────────────────────────────────────
async function carregarDados() {
  try {
    const resp = await fetch(API_HOSPITALARIA + '?acao=hospitalaria');
    const json = await resp.json();

    if (json.erro) throw new Error(json.erro);

    // Agrupa por ano
    dadosPorAno = {};
    (json.lancamentos || []).forEach(l => {
      const ano = new Date(l.data).getFullYear();
      if (!dadosPorAno[ano]) dadosPorAno[ano] = [];
      dadosPorAno[ano].push(l);
    });

    document.getElementById('loadingState').style.display = 'none';
    document.getElementById('conteudo').style.display = 'block';
    renderizarAno();
  } catch(e) {
    document.getElementById('loadingState').innerHTML =
      '<p style="color:#c62828;font-size:14px;">❌ Erro ao carregar dados:<br>' + e.message +
      '<br><br><small>Verifique se a URL da API está configurada corretamente em hospitalaria.html</small></p>';
  }
}

// ── RENDERIZAR ANO ───────────────────────────────────────────
function renderizarAno() {
  lancamentosAno = (dadosPorAno[anoSelecionado] || []).filter(l => l.tipo && l.valor > 0);
  lancamentosAno.sort((a,b) => new Date(a.data) - new Date(b.data));

  document.getElementById('anoGraficoLabel').textContent = anoSelecionado;

  renderKPIs();
  renderGraficoBarra();
  renderGraficoLinha();
  renderTopSaidas();
  renderEstatisticas();
  renderTabela('todos');
}

// ── KPIs ─────────────────────────────────────────────────────
function renderKPIs() {
  const entradas = lancamentosAno.filter(l => l.tipo === 'Entrada');
  const saidas   = lancamentosAno.filter(l => l.tipo === 'Saída');
  const totEnt   = entradas.reduce((s,l) => s + l.valor, 0);
  const totSai   = saidas.reduce((s,l) => s + l.valor, 0);
  const saldo    = totEnt - totSai;
  const mediaEnt = entradas.length > 0 ? totEnt / entradas.length : 0;

  document.getElementById('kpiEntradas').textContent   = fmt(totEnt);
  document.getElementById('kpiEntradasQtd').textContent = entradas.length + ' lançamentos';
  document.getElementById('kpiSaidas').textContent     = fmt(totSai);
  document.getElementById('kpiSaidasQtd').textContent  = saidas.length + ' lançamentos';

  const kpiSaldo = document.getElementById('kpiSaldo');
  kpiSaldo.textContent = fmt(saldo);
  kpiSaldo.closest('.kpi').className = 'kpi ' + (saldo >= 0 ? 'azul' : 'vermelho');

  document.getElementById('kpiMedia').textContent    = fmt(mediaEnt);
  document.getElementById('kpiMediaSub').textContent = 'em ' + entradas.length + ' reuniões';
}

// ── GRÁFICO BARRAS ───────────────────────────────────────────
function renderGraficoBarra() {
  const entMes = Array(12).fill(0);
  const saiMes = Array(12).fill(0);

  lancamentosAno.forEach(l => {
    const m = new Date(l.data).getMonth();
    if (l.tipo === 'Entrada') entMes[m] += l.valor;
    else saiMes[m] += l.valor;
  });

  if (graficoBarra) graficoBarra.destroy();
  graficoBarra = new Chart(document.getElementById('graficoMensal'), {
    type: 'bar',
    data: {
      labels: MESES,
      datasets: [
        { label:'Entradas', data:entMes, backgroundColor:'rgba(46,125,50,.75)', borderRadius:6, borderSkipped:false },
        { label:'Saídas',   data:saiMes, backgroundColor:'rgba(198,40,40,.65)', borderRadius:6, borderSkipped:false }
      ]
    },
    options: {
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ position:'top', labels:{ font:{family:'Poppins',size:11}, boxWidth:12 } } },
      scales:{
        x:{ grid:{display:false}, ticks:{font:{family:'Poppins',size:11}} },
        y:{ grid:{color:'#f0f0f0'}, ticks:{ font:{family:'Poppins',size:11}, callback: v => 'R$'+v.toLocaleString('pt-BR') } }
      }
    }
  });
}

// ── GRÁFICO SALDO ACUMULADO ──────────────────────────────────
function renderGraficoLinha() {
  let acumulado = 0;
  const pontos = [];
  const labels = [];

  lancamentosAno.forEach(l => {
    acumulado += l.tipo === 'Entrada' ? l.valor : -l.valor;
    const d = new Date(l.data);
    labels.push(d.getDate() + '/' + (d.getMonth()+1));
    pontos.push(parseFloat(acumulado.toFixed(2)));
  });

  if (graficoLinha) graficoLinha.destroy();
  graficoLinha = new Chart(document.getElementById('graficoSaldo'), {
    type: 'line',
    data: {
      labels,
      datasets:[{
        label:'Saldo Acumulado',
        data: pontos,
        borderColor:'#1a3a7a',
        backgroundColor:'rgba(26,58,122,.08)',
        fill:true,
        tension:.4,
        pointRadius:3,
        pointBackgroundColor:'#d4af37'
      }]
    },
    options:{
      responsive:true, maintainAspectRatio:false,
      plugins:{ legend:{ display:false } },
      scales:{
        x:{ grid:{display:false}, ticks:{font:{family:'Poppins',size:10}, maxTicksLimit:8} },
        y:{ grid:{color:'#f0f0f0'}, ticks:{ font:{family:'Poppins',size:10}, callback: v => 'R$'+v.toLocaleString('pt-BR') } }
      }
    }
  });
}

// ── TOP SAÍDAS ───────────────────────────────────────────────
function renderTopSaidas() {
  const saidas = lancamentosAno.filter(l => l.tipo === 'Saída')
    .sort((a,b) => b.valor - a.valor).slice(0,5);

  const el = document.getElementById('topSaidas');
  if (!saidas.length) { el.innerHTML = '<div class="empty-state">Sem saídas registradas neste ano.</div>'; return; }

  const ranks = ['ouro','prata','bronze'];
  el.innerHTML = saidas.map((s,i) => {
    const d = new Date(s.data);
    const dataFmt = d.getDate().toString().padStart(2,'0') + '/' + (d.getMonth()+1).toString().padStart(2,'0') + '/' + d.getFullYear();
    return `<div class="top-item">
      <div class="top-rank ${ranks[i]||''}">${i+1}</div>
      <div class="top-info">
        <div class="top-desc" title="${s.descricao||'—'}">${s.descricao||'—'}</div>
        <div class="top-data">${dataFmt}</div>
      </div>
      <div class="top-valor">− ${fmt(s.valor)}</div>
    </div>`;
  }).join('');
}

// ── ESTATÍSTICAS ─────────────────────────────────────────────
function renderEstatisticas() {
  const entradas = lancamentosAno.filter(l => l.tipo === 'Entrada');
  const saidas   = lancamentosAno.filter(l => l.tipo === 'Saída');
  const totEnt   = entradas.reduce((s,l) => s + l.valor, 0);
  const totSai   = saidas.reduce((s,l) => s + l.valor, 0);

  const maxEnt = entradas.length ? Math.max(...entradas.map(l=>l.valor)) : 0;
  const minEnt = entradas.length ? Math.min(...entradas.map(l=>l.valor)) : 0;
  const mediaEnt = entradas.length ? totEnt / entradas.length : 0;
  const pctSaldo = totEnt > 0 ? Math.min(100, ((totEnt - totSai) / totEnt) * 100) : 0;

  document.getElementById('estatisticas').innerHTML = `
    <div class="media-item verde">
      <div class="media-label">Média por entrada (tronco)</div>
      <div class="media-val">${fmt(mediaEnt)}</div>
      <div class="media-sub">${entradas.length} reuniões com arrecadação</div>
    </div>
    <div class="media-item ouro">
      <div class="media-label">Maior entrada registrada</div>
      <div class="media-val">${fmt(maxEnt)}</div>
      <div class="media-sub">Menor: ${fmt(minEnt)}</div>
    </div>
    <div class="media-item">
      <div class="media-label">Saúde financeira (saldo/entradas)</div>
      <div class="media-val" style="font-size:18px;color:#1a3a7a;">${pctSaldo.toFixed(1)}%</div>
      <div class="saldo-bar-wrap">
        <div class="saldo-bar-track"><div class="saldo-bar-fill" style="width:${pctSaldo}%"></div></div>
      </div>
      <div class="media-sub" style="margin-top:4px;">do total arrecadado permanece em caixa</div>
    </div>
  `;
}

// ── TABELA ───────────────────────────────────────────────────
function renderTabela(filtro) {
  const lista = filtro === 'todos'
    ? lancamentosAno
    : lancamentosAno.filter(l => l.tipo === filtro);

  const corpo = document.getElementById('tabelaBody');
  const vazio = document.getElementById('tabelaVazia');
  document.getElementById('totalLancamentos').textContent = lista.length + ' registros';

  if (!lista.length) { corpo.innerHTML=''; vazio.style.display='block'; return; }
  vazio.style.display = 'none';

  corpo.innerHTML = [...lista].reverse().map(l => {
    const d = new Date(l.data);
    const dataFmt = d.getDate().toString().padStart(2,'0')+'/'+
                    (d.getMonth()+1).toString().padStart(2,'0')+'/'+d.getFullYear();
    const isEnt = l.tipo === 'Entrada';
    return `<tr>
      <td>${dataFmt}</td>
      <td><span class="badge-tipo ${isEnt?'badge-entrada':'badge-saida'}">${isEnt?'💰':'📤'} ${l.tipo}</span></td>
      <td class="${isEnt?'valor-pos':'valor-neg'}">${isEnt?'+ ':' − '}${fmt(l.valor)}</td>
      <td style="color:#666;">${l.descricao||'—'}</td>
    </tr>`;
  }).join('');
}

window.filtrarTabela = function(filtro, btn) {
  document.querySelectorAll('.filtro-btn').forEach(b => b.classList.remove('ativo'));
  btn.classList.add('ativo');
  renderTabela(filtro);
};

// ── HELPERS ──────────────────────────────────────────────────
function fmt(v) {
  return 'R$ ' + Number(v).toLocaleString('pt-BR', { minimumFractionDigits:2, maximumFractionDigits:2 });
}
</script>
